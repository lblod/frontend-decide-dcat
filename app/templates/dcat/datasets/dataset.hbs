{{page-title "Dataset"}}

<div class="au-c-main-container" itemprop="mainContentOfPage">
  <div
    class="au-c-main-container__content au-c-main-container__content--scroll"
  >
    <main id="content">
      <Dcat::Dataset @dataset={{@model}} />
      <AuToolbar @size="medium" as |Group|>
        <Group />
        <Group>
          <AuButton
            @skin={{@skin}}
            {{on "click" this.downloadODRLTriplesAsText}}
          >Download ODRL-policy triples</AuButton>
        </Group>
      </AuToolbar>
    </main>
  </div>
</div>